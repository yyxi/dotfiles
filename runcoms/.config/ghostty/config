background = #1d2021
foreground = #ebdbb2
selection-foreground = #928374
selection-background = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #1d2021

cursor-style-blink = true
mouse-hide-while-typing = false

scrollback-limit = 100000000
window-inherit-font-size = true
window-colorspace = display-p3
window-new-tab-position = end
copy-on-select = clipboard
shell-integration = fish
shell-integration-features = cursor, title, sudo, ssh-env
macos-auto-secure-input = true
macos-secure-input-indication = true

font-family = Iosevka Term SS17
font-family-bold = Iosevka Term SS17 Semibold
font-family-italic = Iosevka Term SS17 Italic
font-family-bold-italic = Iosevka Term SS17 Semibold Italic
font-feature = +calt, +ccmp, +lnum, +zero, +mark, +mkmk, +JSPT, +SWFT, +HSKL, +VRLG, +CLIK
font-synthetic-style = false
font-thicken = true
font-size = 14
adjust-cell-height = 2.5%
adjust-underline-position = 4
adjust-underline-thickness = 60%

palette = 0=#1d2021
palette = 1=#cc231c
palette = 2=#989719
palette = 3=#d79920
palette = 4=#448488
palette = 5=#b16185
palette = 6=#689d69
palette = 7=#a89983
palette = 8=#928373
palette = 9=#fb4833
palette = 10=#b8ba25
palette = 11=#fabc2e
palette = 12=#83a597
palette = 13=#d3859a
palette = 14=#8ec07b
palette = 15=#ebdbb2
keybind = shift+enter=text:\x1b\r
