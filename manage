class ManageError(Exception):
    """Raised when the requested final state cannot be reached."""


@dataclasses.dataclass(frozen=True)
class Platform:
    os_name: str
    arch: str

    @property
    def key(self) -> str:
        return "{0}_{1}".format(self.os_name, self.arch)


@dataclasses.dataclass(frozen=True)
class BinarySpec:
    output_name: str
    source_name: Optional[str] = None
    sources: Mapping[str, str] = dataclasses.field(default_factory=dict)
    link_mode: str = "symlink"

    def source_path(self, platform: Platform) -> str:
        return self.sources.get(platform.key) or self.source_name or self.output_name

    def source_basename(self, platform: Platform) -> str:
        return Path(self.source_path(platform)).name


@dataclasses.dataclass(frozen=True)
class ChecksumSpec:
    asset_name: str
    sigstore_bundle_name: Optional[str] = None
    bundle_identity: Optional[str] = None
    bundle_identity_regexp: Optional[str] = None
    bundle_issuer: Optional[str] = None
    certificate_name: Optional[str] = None
    signature_name: Optional[str] = None
    certificate_identity_regexp: Optional[str] = None
    certificate_issuer: Optional[str] = None
    verify_sigstore: bool = False


@dataclasses.dataclass(frozen=True)
class Tool:
    name: str
    version: str
    tag: str
    commit: str
    repository: str
    assets: Mapping[str, str]
    binaries: Tuple[BinarySpec, ...]
    install_layout: str = "binaries"
    strip_components: int = 0
    checksum: Optional[ChecksumSpec] = None
    dependencies: Tuple[str, ...] = ()
    aliases: Tuple[str, ...] = ()
    executable_tools: Tuple[str, ...] = ()
    tag_object: Optional[str] = None
    tag_signature: str = "not_applicable"
    tag_signature_exception: Optional[str] = None
    commit_signature: str = "required"
    commit_signature_exception: Optional[str] = None
    missing_checksum_exception: Optional[str] = None
    selinux_policy: Optional[str] = None
    default: bool = False

    def asset_name(self, platform: Platform) -> str:
        template = self.assets.get(platform.key)
        if template is None:
            raise fatal(
                "{0} does not support platform {1}".format(self.name, platform.key)
            )
        return format_template(template, self)

    def required_external_tools(self, platform: Platform) -> Tuple[str, ...]:
        tools = list(self.executable_tools)
        kind = install_kind_for_asset(self.asset_name(platform))
        if kind == "tar.gz":
            tools.append("tar")
        elif kind == "zip":
            tools.append("unzip")
        elif kind == "bz2":
            tools.append("bunzip2")
        return tuple(sorted(set(tools)))


@dataclasses.dataclass(frozen=True)
class InstallPaths:
    repository: Path
    home: Path

    @property
    def vendor(self) -> Path:
        return self.repository / "vendor"

    @property
    def bin(self) -> Path:
        return self.repository / "bin"

    @property
    def canonical_repository(self) -> Path:
        return self.home / CANONICAL_REPOSITORY

    def is_canonical(self) -> bool:
        return same_path(self.repository, self.canonical_repository)


@dataclasses.dataclass(frozen=True)
class SignatureStatus:
    verified: bool
    reason: str


@dataclasses.dataclass(frozen=True)
class GitResolution:
    commit: str
    tag_object: Optional[str]
    tag_signature: Optional[SignatureStatus]
    commit_signature: Optional[SignatureStatus]


def info(message: str) -> None:
    print(message, flush=True)


def warn(message: str) -> None:
    print("warning: {0}".format(message), file=sys.stderr, flush=True)


def fatal(message: str) -> ManageError:
    return ManageError(message)


def same_path(left: Path, right: Path) -> bool:
    try:
        return left.resolve() == right.resolve()
    except OSError:
        return left.absolute() == right.absolute()


def repository_dir() -> Path:
    return Path(__file__).resolve().parent


def home_dir() -> Path:
    home = os.environ.get("HOME") or os.path.expanduser("~")
    if not home or home == "~":
        raise fatal("unable to determine HOME")
    return Path(home).resolve()


def current_platform() -> Platform:
    system = platform_module.system()
    machine = platform_module.machine()
    if system == "Linux":
        os_name = "linux"
    elif system == "Darwin":
        os_name = "darwin"
    else:
        raise fatal("unsupported operating system: {0}".format(system))

    if machine in ("x86_64", "AMD64"):
        arch = "amd64"
    elif machine in ("aarch64", "arm64"):
        arch = "arm64"
    else:
        raise fatal("unsupported architecture: {0}".format(machine))

    return Platform(os_name=os_name, arch=arch)


def version_from_tag(tag: str) -> str:
    if re.fullmatch(r"v\d+(?:\.\d+)+(?:[-+].*)?", tag):
        return tag[1:]
    return tag


def binary_specs(values: Sequence[Any]) -> Tuple[BinarySpec, ...]:
    specs = []
    for value in values:
        if isinstance(value, str):
            specs.append(BinarySpec(value))
        elif isinstance(value, tuple) and len(value) == 2:
            specs.append(BinarySpec(str(value[0]), str(value[1])))
        elif isinstance(value, dict):
            name = value.get("name")
            if not name:
                raise fatal("binary mapping is missing a name: {0!r}".format(value))
            specs.append(
                BinarySpec(
                    output_name=str(name),
                    source_name=optional_string(value.get("source")),
                    sources=string_mapping(value.get("sources")),
                    link_mode=optional_string(value.get("link_mode")) or "symlink",
                )
            )
        else:
            raise fatal("invalid binary specification: {0!r}".format(value))
    return tuple(specs)


def checksum_spec(value: Optional[Mapping[str, Any]]) -> Optional[ChecksumSpec]:
    if value is None:
        return None
    return ChecksumSpec(
        asset_name=str(value["asset_name"]),
        sigstore_bundle_name=optional_string(value.get("sigstore_bundle_name")),
        bundle_identity=optional_string(value.get("bundle_identity")),
        bundle_identity_regexp=optional_string(value.get("bundle_identity_regexp")),
        bundle_issuer=optional_string(value.get("bundle_issuer")),
        certificate_name=optional_string(value.get("certificate_name")),
        signature_name=optional_string(value.get("signature_name")),
        certificate_identity_regexp=optional_string(
            value.get("certificate_identity_regexp")
        ),
        certificate_issuer=optional_string(value.get("certificate_issuer")),
        verify_sigstore=bool(value.get("verify_sigstore", False)),
    )


def optional_string(value: Any) -> Optional[str]:
    if value is None:
        return None
    return str(value)


def string_tuple(value: Any) -> Tuple[str, ...]:
    if value is None:
        return ()
    return tuple(str(item) for item in value)


def string_mapping(value: Any) -> Mapping[str, str]:
    if value is None:
        return {}
    if not isinstance(value, dict):
        raise fatal("asset mapping must be a dictionary")
    return {str(key): str(item) for key, item in value.items()}


def signature_requirement(signature: Any, name: str) -> str:
    if not isinstance(signature, dict):
        return "not_applicable" if name == "tag" else "required"
    value = signature.get(name)
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        if "allow_unsigned" in value:
            return "allow_unsigned"
        if "allow_unverified" in value:
            return "allow_unverified"
    return "not_applicable" if name == "tag" else "required"


def signature_exception(signature: Any, name: str) -> Optional[str]:
    if not isinstance(signature, dict):
        return None
    value = signature.get(name)
    if isinstance(value, dict):
        if "allow_unsigned" in value:
            return str(value["allow_unsigned"])
        if "allow_unverified" in value:
            return str(value["allow_unverified"])
    return None


def tool_from_config(name: str, config: Mapping[str, Any]) -> Tool:
    tag = str(config["tag"])
    return Tool(
        name=name,
        version=str(config.get("version") or version_from_tag(tag)),
        tag=tag,
        commit=str(config["commit"]),
        repository=str(config["repository"]),
        assets=string_mapping(config.get("assets")),
        binaries=binary_specs(config.get("binaries", ())),
        install_layout=str(config.get("install_layout", "binaries")),
        strip_components=int(config.get("strip_components", 0)),
        checksum=checksum_spec(config.get("checksum")),
        dependencies=string_tuple(config.get("dependencies")),
        aliases=string_tuple(config.get("aliases")),
        executable_tools=string_tuple(config.get("executable_tools")),
        tag_object=optional_string(config.get("tag_object")),
        tag_signature=signature_requirement(config.get("signature"), "tag"),
        tag_signature_exception=signature_exception(config.get("signature"), "tag"),
        commit_signature=signature_requirement(config.get("signature"), "commit"),
        commit_signature_exception=signature_exception(
            config.get("signature"), "commit"
        )
        or optional_string(config.get("unsigned_commit_exception")),
        missing_checksum_exception=optional_string(
            config.get("missing_checksum_exception")
        ),
        selinux_policy=optional_string(config.get("selinux_policy")),
        default=bool(config.get("default", False)),
    )


TOOLS = {name: tool_from_config(name, config) for name, config in TOOL_CONFIGS.items()}
DEFAULT_INSTALL = tuple(name for name, tool in TOOLS.items() if tool.default)
ALIASES = {alias: tool.name for tool in TOOLS.values() for alias in tool.aliases}


def asset_name(tool: Tool, platform: Platform) -> str:
    return tool.asset_name(platform)


def format_template(template: str, tool: Tool) -> str:
    return template.format(version=tool.version, tag=tool.tag)


def request_headers() -> Dict[str, str]:
    return {
        "Accept": "application/vnd.github+json",
        "User-Agent": GITHUB_USER_AGENT,
        "X-GitHub-Api-Version": "2022-11-28",
    }


def retry_delay(headers: Any, body: str, attempt: int) -> Optional[int]:
    retry_after = headers.get("Retry-After")
    if retry_after and retry_after.isdigit():
        return max(1, int(retry_after))

    reset = headers.get("X-RateLimit-Reset")
    remaining = headers.get("X-RateLimit-Remaining")
    rate_limited = remaining == "0" or "rate limit" in body.lower()
    if reset and reset.isdigit() and rate_limited:
        return max(1, int(reset) - int(time.time()) + 2)
    if rate_limited:
        return min(60, 5 * (2**attempt))
    return None


def urlopen_with_retries(
    request: urllib.request.Request, timeout: int, purpose: str
) -> Any:
    max_attempts = 4
    for attempt in range(max_attempts):
        try:
            return urllib.request.urlopen(request, timeout=timeout)
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")
            delay = retry_delay(exc.headers, body, attempt)
            if (
                exc.code in (403, 429)
                and delay is not None
                and attempt < max_attempts - 1
            ):
                if delay > MAX_AUTOMATIC_RATE_LIMIT_SLEEP_SECONDS:
                    raise fatal(
                        "{0} is rate-limited for {1} seconds; try again after the reset".format(
                            purpose, delay
                        )
                    )
                warn(
                    "{0} is rate-limited; waiting {1} seconds before retrying".format(
                        purpose, delay
                    )
                )
                time.sleep(delay)
                continue
            raise fatal(
                "{0} failed for {1}: HTTP {2}: {3}".format(
                    purpose, request.full_url, exc.code, body
                )
            )
        except OSError as exc:
            if attempt < max_attempts - 1:
                delay = min(30, 2 * (attempt + 1))
                warn(
                    "{0} failed for {1}: {2}; retrying in {3} seconds".format(
                        purpose, request.full_url, exc, delay
                    )
                )
                time.sleep(delay)
                continue
            raise fatal(
                "{0} failed for {1}: {2}".format(purpose, request.full_url, exc)
            )
    raise fatal("{0} failed for {1}".format(purpose, request.full_url))


def warn_if_rate_limit_low(headers: Any) -> None:
    global RATE_LIMIT_LOW_WARNED
    if RATE_LIMIT_LOW_WARNED:
        return
    remaining = headers.get("X-RateLimit-Remaining")
    reset = headers.get("X-RateLimit-Reset")
    if remaining and remaining.isdigit() and int(remaining) <= 5:
        RATE_LIMIT_LOW_WARNED = True
        reset_text = ""
        if reset and reset.isdigit():
            reset_text = "; reset at {0}".format(
                time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(reset)))
            )
        warn(
            "GitHub API rate limit is nearly exhausted ({0} remaining{1})".format(
                remaining, reset_text
            )
        )


def github_json(path: str) -> Any:
    url = "{0}/{1}".format(GITHUB_API, path.lstrip("/"))
    request = urllib.request.Request(url, headers=request_headers())
    try:
        with urlopen_with_retries(
            request, timeout=30, purpose="GitHub API request"
        ) as response:
            warn_if_rate_limit_low(response.headers)
            return json.loads(response.read().decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise fatal(
            "GitHub API request returned invalid JSON for {0}: {1}".format(url, exc)
        )


def download_url(url: str, destination: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": GITHUB_USER_AGENT})
    with urlopen_with_retries(request, timeout=60, purpose="download") as response:
        with destination.open("wb") as output:
            shutil.copyfileobj(response, output)


def signature_status(value: Any) -> SignatureStatus:
    if not isinstance(value, dict):
        return SignatureStatus(verified=False, reason="missing")
    return SignatureStatus(
        verified=bool(value.get("verified")),
        reason=str(value.get("reason") or "unknown"),
    )


def commit_status_from_response(
    repository: str, commit: str, data: Any
) -> GitResolution:
    if not isinstance(data, dict):
        raise fatal(
            "commit response for {0}@{1} was not an object".format(repository, commit)
        )
    sha = data.get("sha")
    commit_data = data.get("commit")
    verification: Any = {}
    if isinstance(commit_data, dict):
        verification = commit_data.get("verification", {})
    if not isinstance(sha, str):
        raise fatal(
            "commit response for {0}@{1} did not include a sha".format(
                repository, commit
            )
        )
    return GitResolution(
        commit=sha,
        tag_object=None,
        tag_signature=None,
        commit_signature=signature_status(verification),
    )


def resolve_by_commit_api(tool: Tool, include_commit_signature: bool) -> GitResolution:
    data = github_json(
        "repos/{0}/commits/{1}".format(
            tool.repository, urllib.parse.quote(tool.tag, safe="")
        )
    )
    resolution = commit_status_from_response(tool.repository, tool.tag, data)
    if include_commit_signature:
        return resolution
    return GitResolution(
        commit=resolution.commit,
        tag_object=None,
        tag_signature=None,
        commit_signature=None,
    )


def resolve_by_tag_api(tool: Tool, include_commit_signature: bool) -> GitResolution:
    ref = github_json(
        "repos/{0}/git/ref/tags/{1}".format(
            tool.repository, urllib.parse.quote(tool.tag, safe="")
        )
    )
    obj = ref.get("object") if isinstance(ref, dict) else None
    if not isinstance(obj, dict):
        raise fatal(
            "tag ref {0}@{1} did not include an object".format(
                tool.repository, tool.tag
            )
        )
    tag_object = obj.get("sha")
    object_type = obj.get("type")
    if not isinstance(tag_object, str):
        raise fatal(
            "tag ref {0}@{1} did not include an object sha".format(
                tool.repository, tool.tag
            )
        )
    if object_type != "tag":
        raise fatal("{0} tag {1} is not an annotated tag".format(tool.name, tool.tag))
    if tool.tag_object and tag_object != tool.tag_object:
        raise fatal(
            "{0} tag object resolved to {1}, expected {2}".format(
                tool.name, tag_object, tool.tag_object
            )
        )
    tag_data = github_json("repos/{0}/git/tags/{1}".format(tool.repository, tag_object))
    nested = tag_data.get("object") if isinstance(tag_data, dict) else None
    if not isinstance(nested, dict):
        raise fatal("tag object {0} did not include a target object".format(tag_object))
    commit = nested.get("sha")
    nested_type = nested.get("type")
    if nested_type != "commit" or not isinstance(commit, str):
        raise fatal("tag object {0} does not point to a commit".format(tag_object))
    tag_signature = signature_status(
        tag_data.get("verification") if isinstance(tag_data, dict) else None
    )
    commit_signature = None
    if include_commit_signature:
        commit_data = github_json(
            "repos/{0}/commits/{1}".format(
                tool.repository, urllib.parse.quote(commit, safe="")
            )
        )
        commit_resolution = commit_status_from_response(
            tool.repository, commit, commit_data
        )
        commit_signature = commit_resolution.commit_signature
    return GitResolution(
        commit=commit,
        tag_object=tag_object,
        tag_signature=tag_signature,
        commit_signature=commit_signature,
    )


def verify_signature_expectation(
    tool: Tool, kind: str, requirement: str, status: Optional[SignatureStatus]
) -> None:
    if requirement == "not_applicable":
        return
    reason = (
        tool.commit_signature_exception
        if kind == "commit"
        else tool.tag_signature_exception
    )
    if status is None:
        if requirement in ("allow_unsigned", "allow_unverified") and reason:
            return
        raise fatal("{0} {1} signature was not checked".format(tool.name, kind))
    if requirement == "required":
        if not status.verified:
            raise fatal(
                "{0} {1} signature is not verified by GitHub: {2}".format(
                    tool.name, kind, status.reason
                )
            )
        return
    if requirement == "allow_unsigned":
        if status.verified:
            return
        if status.reason != "unsigned":
            raise fatal(
                "{0} {1} signature is {2}, not unsigned".format(
                    tool.name, kind, status.reason
                )
            )
    elif requirement == "allow_unverified":
        if status.verified:
            return
    else:
        raise fatal("unknown {0} signature requirement: {1}".format(kind, requirement))

    if not reason:
        raise fatal(
            "{0} {1} signature exception is missing for {2}".format(
                tool.name, kind, requirement
            )
        )
    warn(
        "{0}: accepting {1} signature state ({2}): {3}".format(
            tool.name, kind, status.reason, reason
        )
    )


def commit_signature_needs_api(tool: Tool) -> bool:
    if tool.commit_signature == "required":
        return True
    if tool.commit_signature == "allow_unverified":
        return True
    if (
        tool.commit_signature == "allow_unsigned"
        and tool.tag_signature == "not_applicable"
    ):
        return True
    return False


def verify_tag_and_commit(tool: Tool, check_signature: bool = True) -> None:
    include_commit_signature = check_signature and commit_signature_needs_api(tool)
    if check_signature and tool.tag_signature == "required":
        resolution = resolve_by_tag_api(tool, include_commit_signature)
    else:
        resolution = resolve_by_commit_api(tool, include_commit_signature)
    if resolution.commit != tool.commit:
        raise fatal(
            "{0} tag {1} resolved to {2}, expected {3}".format(
                tool.name, tool.tag, resolution.commit, tool.commit
            )
        )
    if not check_signature:
        return
    verify_signature_expectation(
        tool, "tag", tool.tag_signature, resolution.tag_signature
    )
    verify_signature_expectation(
        tool, "commit", tool.commit_signature, resolution.commit_signature
    )


def parse_checksums(text: str) -> Dict[str, str]:
    checksums = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        digest = parts[0].strip()
        if not re.fullmatch(r"[A-Fa-f0-9]{64}", digest):
            continue
        raw_name = parts[1].lstrip("*")
        name = Path(raw_name).name
        checksums[name] = digest.lower()
        checksums[raw_name] = digest.lower()
    return checksums


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def verify_file_sha256(path: Path, expected: str) -> None:
    actual = sha256_file(path)
    if actual.lower() != expected.lower():
        raise fatal(
            "SHA-256 mismatch for {0}: expected {1}, got {2}".format(
                path, expected, actual
            )
        )


def manifest_checksum(manifest_path: Path, asset: str) -> str:
    checksums = parse_checksums(manifest_path.read_text(encoding="utf-8"))
    checksum = checksums.get(asset) or checksums.get(Path(asset).name)
    if not checksum:
        raise fatal(
            "checksum manifest {0} did not include {1}".format(manifest_path, asset)
        )
    return checksum


def sanitized_environment() -> Dict[str, str]:
    env = os.environ.copy()
    for name in ("GH_TOKEN", "GITHUB_TOKEN", "GITHUB_OAUTH_TOKEN"):
        env.pop(name, None)
    return env


CleanupScope = Literal["group", "process"]


def terminate_process_tree(process: Any, scope: CleanupScope) -> None:
    def send(sig: int) -> None:
        with contextlib.suppress(ProcessLookupError, OSError):
            if scope == "group":
                os.killpg(process.pid, sig)
            else:
                process.send_signal(sig)

    send(signal.SIGTERM)
    with contextlib.suppress(subprocess.TimeoutExpired):
        process.wait(timeout=5)
        return
    send(signal.SIGKILL)
    with contextlib.suppress(OSError):
        process.wait(timeout=5)


def run_command_result(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    env: Optional[Mapping[str, str]] = None,
) -> Any:
    try:
        return subprocess.run(
            list(command),
            cwd=str(cwd) if cwd else None,
            env=dict(env) if env is not None else sanitized_environment(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise fatal("unable to run {0}: {1}".format(command[0], exc))


def command_result_or_raise(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    env: Optional[Mapping[str, str]] = None,
) -> Any:
    result = run_command_result(command, cwd=cwd, env=env)
    if result.returncode == 0:
        return result
    stdout = result.stdout.strip() if isinstance(result.stdout, str) else ""
    stderr = result.stderr.strip() if isinstance(result.stderr, str) else ""
    parts = []
    if stderr:
        parts.append("stderr: {0}".format(stderr))
    if stdout:
        parts.append("stdout: {0}".format(stdout))
    detail = ": {0}".format("; ".join(parts)) if parts else ""
    raise fatal(
        "command failed with exit code {0}: {1}{2}".format(
            result.returncode, " ".join(command), detail
        )
    )


def run_command(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    stdout: Optional[Any] = None,
    stderr: Optional[Any] = None,
    env: Optional[Mapping[str, str]] = None,
    interactive: bool = False,
) -> None:
    # interactive=False: detach into a new session so SIGINT to the terminal
    # reaches only the parent; cleanup can safely killpg the whole tree.
    # interactive=True: stay in the parent's session and process group so the
    # child remains foreground on the controlling TTY (required for prompts);
    # cleanup is process-scoped to avoid signalling the parent.
    cleanup_scope: CleanupScope = "process" if interactive else "group"
    process: Any = None
    try:
        process = subprocess.Popen(
            list(command),
            cwd=str(cwd) if cwd else None,
            env=dict(env) if env is not None else sanitized_environment(),
            stdout=stdout,
            stderr=stderr,
            start_new_session=not interactive,
        )
        return_code = process.wait()
    except OSError as exc:
        raise fatal("unable to run {0}: {1}".format(command[0], exc))
    except BaseException:
        if process is not None and process.poll() is None:
            terminate_process_tree(process, scope=cleanup_scope)
        raise
    if return_code != 0:
        raise fatal(
            "command failed with exit code {0}: {1}".format(
                return_code, " ".join(command)
            )
        )


def command_output(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    env: Optional[Mapping[str, str]] = None,
) -> str:
    return command_result_or_raise(command, cwd=cwd, env=env).stdout.strip()


def check_external_tools(tools: Iterable[str]) -> None:
    missing = sorted({tool for tool in tools if shutil.which(tool) is None})
    if missing:
        raise fatal("missing required command(s): {0}".format(", ".join(missing)))


def version_data(tool: Tool, asset: str) -> Dict[str, str]:
    return {
        "name": tool.name,
        "version": tool.version,
        "tag": tool.tag,
        "commit": tool.commit,
        "asset": asset,
    }


def read_version_file(path: Path) -> Dict[str, str]:
    parser = configparser.ConfigParser()
    try:
        with path.open("r", encoding="utf-8") as stream:
            parser.read_file(stream)
    except (OSError, configparser.Error):
        return {}
    if not parser.has_section("install"):
        return {}
    return {key: value for key, value in parser.items("install")}


def write_version_file(path: Path, data: Mapping[str, str]) -> None:
    parser = configparser.ConfigParser()
    parser["install"] = dict(data)
    with path.open("w", encoding="utf-8") as stream:
        parser.write(stream)


def is_executable_file(path: Path) -> bool:
    return path.is_file() and os.access(str(path), os.X_OK)


def set_executable(path: Path) -> None:
    mode = path.stat().st_mode
    path.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def tool_directory(paths: InstallPaths, tool: Tool) -> Path:
    return paths.vendor / tool.name


def expected_binary_path(
    paths: InstallPaths, tool: Tool, platform: Platform, binary: BinarySpec
) -> Path:
    if tool.install_layout == "archive":
        return tool_directory(paths, tool) / binary.source_path(platform)
    return tool_directory(paths, tool) / binary.output_name


def command_path(name: str) -> Optional[str]:
    found = shutil.which(name)
    if found is not None:
        return found
    for directory in ("/usr/sbin", "/usr/bin", "/sbin", "/bin"):
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(str(candidate), os.X_OK):
            return str(candidate)
    return None


def resolved_command_paths(names: Iterable[str]) -> Dict[str, str]:
    found: Dict[str, str] = {}
    for name in names:
        path = command_path(name)
        if path is not None:
            found[name] = path
    return found


def os_release_data() -> Dict[str, str]:
    lines: Optional[List[str]] = None
    for path in (Path("/etc/os-release"), Path("/usr/lib/os-release")):
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeError):
            continue
        break
    if lines is None:
        return {}

    data: Dict[str, str] = {}
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in raw_line:
            continue
        key, raw_value = raw_line.split("=", 1)
        key = key.strip()
        if not key:
            continue
        value = raw_value.strip()
        if value[:1] in ("'", '"'):
            try:
                parts = shlex.split(value, posix=True)
            except ValueError:
                value = value.strip("'\"")
            else:
                value = " ".join(parts)
        data[key] = value
    return data


def os_release_tokens(values: Iterable[str]) -> Set[str]:
    tokens: Set[str] = set()
    for value in values:
        for token in re.split(r"[\s,]+", value.lower().strip()):
            if token:
                tokens.add(token)
    return tokens


def is_el10() -> bool:
    data = os_release_data()
    platform_id = data.get("PLATFORM_ID", "").strip().lower()
    if "el10" in platform_id:
        return True
    version_id = data.get("VERSION_ID", "").strip()
    if not version_id.startswith("10"):
        return False
    tokens = os_release_tokens(
        data.get(key, "") for key in ("ID", "ID_LIKE", "REDHAT_SUPPORT_PRODUCT")
    )
    return bool(tokens & EL10_FAMILY_IDS)


def selinux_is_enabled() -> bool:
    selinux_fs = Path("/sys/fs/selinux")
    if not selinux_fs.exists():
        return False

    selinuxenabled = command_path("selinuxenabled")
    if selinuxenabled is not None:
        try:
            result = subprocess.run(
                [selinuxenabled],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            pass
        else:
            return result.returncode == 0

    getenforce = command_path("getenforce")
    if getenforce is not None:
        try:
            result = subprocess.run(
                [getenforce],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
        except OSError:
            pass
        else:
            return (
                result.returncode == 0 and result.stdout.strip().lower() != "disabled"
            )

    return True


def sudo_noninteractive_result(
    sudo_path: str,
    command: Sequence[str],
    cwd: Optional[Path] = None,
) -> Any:
    return run_command_result(
        [sudo_path, "-n", *command],
        cwd=cwd,
        env=sanitized_environment(),
    )


def sudo_noninteractive_or_raise(
    sudo_path: str,
    command: Sequence[str],
    cwd: Optional[Path] = None,
) -> Any:
    return command_result_or_raise(
        [sudo_path, "-n", *command],
        cwd=cwd,
        env=sanitized_environment(),
    )


def selinux_noninteractive_sudo_ready(
    paths: InstallPaths, command_paths: Mapping[str, str]
) -> bool:
    probes = (
        (command_paths["semodule"], "-l"),
        (command_paths["semanage"], "fcontext", "-l"),
        (command_paths["restorecon"], "-n", str(paths.repository)),
    )
    for probe in probes:
        if sudo_noninteractive_result(command_paths["sudo"], probe).returncode != 0:
            return False
    return True


def selinux_policy_module_name(policy: str) -> str:
    return policy.replace("-", "_")


def selinux_policy_directory(paths: InstallPaths, tool: Tool) -> Path:
    if not tool.selinux_policy:
        raise fatal("{0} does not define a SELinux policy".format(tool.name))
    directory = paths.repository / "selinux" / tool.selinux_policy
    if not directory.is_dir():
        raise fatal(
            "missing SELinux policy directory for {0}: {1}".format(tool.name, directory)
        )
    return directory


def selinux_exec_type_name(policy: str) -> str:
    return "{0}_exec_t".format(selinux_policy_module_name(policy))


def selinux_entrypoint_paths(
    paths: InstallPaths, tool: Tool, platform: Platform
) -> Tuple[Path, ...]:
    entrypoints: List[Path] = []
    for binary in tool.binaries:
        entrypoints.append(expected_binary_path(paths, tool, platform, binary))
        if binary.link_mode == "wrapper":
            entrypoints.append(paths.bin / binary.output_name)
        elif binary.link_mode != "symlink":
            raise fatal(
                "unsupported link mode for {0}: {1}".format(
                    binary.output_name, binary.link_mode
                )
            )
    return tuple(dict.fromkeys(entrypoints))


def selinux_fcontext_expression(path: Path) -> str:
    return "^{0}$".format(re.escape(str(path)))


def link_points_inside_repository(link: Path, repository: Path) -> bool:
    if not link.is_symlink():
        return False
    try:
        target = link.resolve(strict=False)
        repo = repository.resolve(strict=False)
    except OSError:
        return False
    return target == repo or repo in target.parents


def binary_wrapper_script(target: Path) -> str:
    return '#!/bin/sh\nexec {0} "$@"\n'.format(shlex.quote(str(target)))


def ensure_bin_link(paths: InstallPaths, binary_name: str, target: Path) -> None:
    paths.bin.mkdir(parents=True, exist_ok=True)
    link = paths.bin / binary_name
    if link.is_symlink():
        current = link.resolve(strict=False)
        if current == target.resolve(strict=False):
            return
        if link_points_inside_repository(link, paths.repository):
            link.unlink()
        else:
            raise fatal(
                "refusing to replace symlink outside this repository: {0}".format(link)
            )
    elif link.exists():
        raise fatal("refusing to overwrite non-symlink: {0}".format(link))
    try:
        os.symlink(str(target), str(link))
    except OSError as exc:
        raise fatal("unable to link {0} to {1}: {2}".format(link, target, exc))


def ensure_bin_wrapper(paths: InstallPaths, binary_name: str, target: Path) -> None:
    if os.name == "nt":
        raise fatal(
            "wrapper launch mode is not supported on Windows: {0}".format(binary_name)
        )
    paths.bin.mkdir(parents=True, exist_ok=True)
    wrapper = paths.bin / binary_name
    script = binary_wrapper_script(target)
    if wrapper.is_symlink():
        if link_points_inside_repository(wrapper, paths.repository):
            wrapper.unlink()
        else:
            raise fatal(
                "refusing to replace symlink outside this repository: {0}".format(
                    wrapper
                )
            )
    elif wrapper.exists():
        if not wrapper.is_file():
            raise fatal("refusing to overwrite non-file: {0}".format(wrapper))
        current = wrapper.read_text(encoding="utf-8")
        if current == script:
            set_executable(wrapper)
            return
        if not link_points_inside_repository(wrapper, paths.repository):
            raise fatal(
                "refusing to overwrite file outside this repository: {0}".format(
                    wrapper
                )
            )
    wrapper.write_text(script, encoding="utf-8")
    set_executable(wrapper)


def ensure_tool_links(paths: InstallPaths, tool: Tool, platform: Platform) -> None:
    for binary in tool.binaries:
        target = expected_binary_path(paths, tool, platform, binary)
        if binary.link_mode == "symlink":
            ensure_bin_link(paths, binary.output_name, target)
        elif binary.link_mode == "wrapper":
            ensure_bin_wrapper(paths, binary.output_name, target)
        else:
            raise fatal(
                "unsupported link mode for {0}: {1}".format(
                    binary.output_name, binary.link_mode
                )
            )


def ensure_selinux_policy_module_once(
    paths: InstallPaths,
    tool: Tool,
    policy_status: Dict[str, bool],
    make_path: str,
    sudo_path: str,
    semodule_path: str,
) -> None:
    if not tool.selinux_policy:
        raise fatal("{0} does not define a SELinux policy".format(tool.name))
    if policy_status.get(tool.selinux_policy):
        return

    directory = selinux_policy_directory(paths, tool)
    module_name = selinux_policy_module_name(tool.selinux_policy)
    package = directory / "{0}.pp".format(module_name)
    command_result_or_raise(
        [make_path, "-f", "/usr/share/selinux/devel/Makefile", package.name],
        cwd=directory,
    )
    if not package.is_file():
        raise fatal("SELinux build did not produce {0}".format(package))
    sudo_noninteractive_or_raise(sudo_path, [semodule_path, "-i", str(package)])
    policy_status[tool.selinux_policy] = True


def apply_selinux_fcontext(
    sudo_path: str, semanage_path: str, exec_type: str, path: Path
) -> None:
    expression = selinux_fcontext_expression(path)
    add_command = [semanage_path, "fcontext", "-a", "-t", exec_type, expression]
    add_result = sudo_noninteractive_result(sudo_path, add_command)
    if add_result.returncode == 0:
        return

    modify_command = [semanage_path, "fcontext", "-m", "-t", exec_type, expression]
    modify_result = sudo_noninteractive_result(sudo_path, modify_command)
    if modify_result.returncode == 0:
        return

    add_stderr = add_result.stderr.strip()
    modify_stderr = modify_result.stderr.strip()
    raise fatal(
        "unable to configure SELinux file context for {0}: {1}; {2}".format(
            path,
            add_stderr or " ".join(add_command),
            modify_stderr or " ".join(modify_command),
        )
    )


def skip_tool_selinux_policy(
    tool: Tool, policy_status: Dict[str, bool], reason: str
) -> None:
    if not tool.selinux_policy:
        raise fatal("{0} does not define a SELinux policy".format(tool.name))
    warn("{0}: skipping SELinux setup because {1}".format(tool.name, reason))
    policy_status[tool.selinux_policy] = False


def apply_tool_selinux_policy(
    paths: InstallPaths,
    platform: Platform,
    tool: Tool,
    policy_status: Dict[str, bool],
    disable_selinux: bool = False,
) -> None:
    if disable_selinux or not tool.selinux_policy or platform.os_name != "linux":
        return
    if tool.selinux_policy in policy_status and not policy_status[tool.selinux_policy]:
        return
    if not is_el10():
        skip_tool_selinux_policy(
            tool, policy_status, "host is not recognized as EL10-family"
        )
        return
    if not selinux_is_enabled():
        skip_tool_selinux_policy(tool, policy_status, "SELinux is not enabled")
        return

    command_paths = resolved_command_paths(SELINUX_REQUIRED_BINARIES)
    missing = [name for name in SELINUX_REQUIRED_BINARIES if name not in command_paths]
    if missing:
        skip_tool_selinux_policy(
            tool,
            policy_status,
            "required command(s) are missing: {0}".format(", ".join(missing)),
        )
        return

    if not selinux_noninteractive_sudo_ready(paths, command_paths):
        skip_tool_selinux_policy(
            tool,
            policy_status,
            "required SELinux sudo commands are not available non-interactively",
        )
        return

    ensure_selinux_policy_module_once(
        paths,
        tool,
        policy_status,
        command_paths["make"],
        command_paths["sudo"],
        command_paths["semodule"],
    )
    exec_type = selinux_exec_type_name(tool.selinux_policy)
    for entrypoint in selinux_entrypoint_paths(paths, tool, platform):
        apply_selinux_fcontext(
            command_paths["sudo"],
            command_paths["semanage"],
            exec_type,
            entrypoint,
        )
        sudo_noninteractive_or_raise(
            command_paths["sudo"],
            [command_paths["restorecon"], "-v", str(entrypoint)],
        )


def installed_payload_ok(paths: InstallPaths, tool: Tool, platform: Platform) -> bool:
    directory = tool_directory(paths, tool)
    asset = asset_name(tool, platform)
    if read_version_file(directory / "version") != version_data(tool, asset):
        return False
    for binary in tool.binaries:
        if not is_executable_file(expected_binary_path(paths, tool, platform, binary)):
            return False
    return True


def installed_state_ok(paths: InstallPaths, tool: Tool, platform: Platform) -> bool:
    if not installed_payload_ok(paths, tool, platform):
        return False
    ensure_tool_links(paths, tool, platform)
    return True


def process_is_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def cleanup_stale_staging(paths: InstallPaths, tools: Iterable[Tool]) -> None:
    if not paths.vendor.is_dir():
        return
    tool_names = {tool.name for tool in tools}
    for path in paths.vendor.iterdir():
        parts = path.name.split(".")
        if len(parts) < 4 or parts[0] != "" or parts[1] not in tool_names:
            continue
        tool_name = parts[1]
        if parts[2] == "previous":
            if len(parts) < 5 or not parts[3].isdigit():
                continue
            pid = int(parts[3])
            destination = paths.vendor / tool_name
            if process_is_alive(pid):
                continue
            if destination.exists() or destination.is_symlink():
                warn("removing stale backup {0}".format(path))
                remove_path(path)
            else:
                warn("restoring stale backup {0}".format(path))
                path.rename(destination)
            continue
        if not parts[2].isdigit():
            continue
        pid = int(parts[2])
        if process_is_alive(pid):
            continue
        warn("removing stale staging directory {0}".format(path))
        remove_path(path)


@contextlib.contextmanager
def staging_directory(paths: InstallPaths, tool: Tool) -> Iterator[Path]:
    paths.vendor.mkdir(parents=True, exist_ok=True)
    temp = tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(tool.name, os.getpid()), dir=str(paths.vendor)
    )
    try:
        yield Path(temp.name)
    finally:
        temp.cleanup()


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(str(path))


def replace_tool_directory(
    paths: InstallPaths, tool: Tool, staged_install: Path
) -> None:
    destination = tool_directory(paths, tool)
    backup: Optional[Path] = None
    existing_was_moved = False
    try:
        if destination.exists() or destination.is_symlink():
            backup = paths.vendor / ".{0}.previous.{1}.{2}".format(
                tool.name, os.getpid(), time.time_ns()
            )
            destination.rename(backup)
            existing_was_moved = True
        staged_install.rename(destination)
    except BaseException as exc:
        if existing_was_moved and backup is not None and not destination.exists():
            with contextlib.suppress(OSError):
                backup.rename(destination)
        if isinstance(exc, OSError):
            raise fatal("unable to install {0}: {1}".format(destination, exc))
        raise
    if backup is not None and (backup.exists() or backup.is_symlink()):
        remove_path(backup)


def stripped_relative_path(path: Path, strip_components: int) -> Optional[Path]:
    if strip_components <= 0:
        return path
    parts = path.parts[strip_components:]
    if not parts:
        return None
    return Path(*parts)


def copy_extracted_tree(source: Path, destination: Path, strip_components: int) -> None:
    for path in sorted(source.rglob("*")):
        relative = path.relative_to(source)
        stripped = stripped_relative_path(relative, strip_components)
        if stripped is None:
            continue
        target = destination / stripped
        if path.is_symlink():
            if target.exists() or target.is_symlink():
                raise fatal("archive extraction collision at {0}".format(target))
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(path), str(target))
        elif path.is_dir():
            if target.exists() and not target.is_dir():
                raise fatal("archive extraction collision at {0}".format(target))
            target.mkdir(parents=True, exist_ok=True)
        elif path.is_file():
            if target.exists() or target.is_symlink():
                raise fatal("archive extraction collision at {0}".format(target))
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(path), str(target))


def prepare_extracted_tree(source: Path, work_dir: Path, strip_components: int) -> Path:
    if strip_components <= 0:
        return source
    stripped = work_dir / "stripped"
    stripped.mkdir(parents=True, exist_ok=True)
    copy_extracted_tree(source, stripped, strip_components)
    return stripped


def find_extracted_file(
    root: Path, tool: Tool, binary: BinarySpec, platform: Platform
) -> Path:
    source_path = Path(binary.source_path(platform))
    if len(source_path.parts) > 1:
        exact = root / source_path
        if exact.is_file():
            return exact
        raise fatal("extracted archive did not contain {0}".format(source_path))
    candidates = sorted(path for path in root.rglob(str(source_path)) if path.is_file())
    if not candidates:
        raise fatal("extracted archive did not contain {0}".format(source_path))
    return candidates[0]


def extract_archive(kind: str, archive: Path, extract_dir: Path) -> None:
    extract_dir.mkdir(parents=True, exist_ok=True)
    if kind == "tar.gz":
        run_command(["tar", "-xzf", str(archive), "-C", str(extract_dir)])
    elif kind == "zip":
        run_command(["unzip", "-oqq", str(archive), "-d", str(extract_dir)])
    else:
        raise fatal("unsupported archive kind: {0}".format(kind))


def install_kind_for_asset(asset: str) -> str:
    if asset.endswith((".tar.gz", ".tgz")):
        return "tar.gz"
    if asset.endswith(".zip"):
        return "zip"
    if asset.endswith(".bz2"):
        return "bz2"
    if asset.endswith(".gz"):
        return "gz"
    return "direct"


def install_downloaded_asset(
    tool: Tool, platform: Platform, downloaded: Path, install_dir: Path, work_dir: Path
) -> None:
    kind = install_kind_for_asset(asset_name(tool, platform))

    if kind == "direct":
        if len(tool.binaries) != 1:
            raise fatal(
                "direct install requires exactly one binary for {0}".format(tool.name)
            )
        target = install_dir / tool.binaries[0].output_name
        shutil.copy2(str(downloaded), str(target))
        set_executable(target)
        return

    if kind == "bz2":
        if len(tool.binaries) != 1:
            raise fatal(
                "bz2 install requires exactly one binary for {0}".format(tool.name)
            )
        target = install_dir / tool.binaries[0].output_name
        with target.open("wb") as output:
            run_command(["bunzip2", "-c", str(downloaded)], stdout=output)
        set_executable(target)
        return

    if kind == "gz":
        if len(tool.binaries) != 1:
            raise fatal(
                "gzip install requires exactly one binary for {0}".format(tool.name)
            )
        target = install_dir / tool.binaries[0].output_name
        with gzip.open(downloaded, "rb") as source, target.open("wb") as output:
            shutil.copyfileobj(source, output)
        set_executable(target)
        return

    extract_dir = work_dir / "extract"
    extract_archive(kind, downloaded, extract_dir)
    if tool.install_layout == "archive":
        copy_extracted_tree(extract_dir, install_dir, tool.strip_components)
        for binary in tool.binaries:
            target = install_dir / binary.source_path(platform)
            if not target.is_file():
                raise fatal("archive install did not contain {0}".format(target))
            set_executable(target)
        return
    if tool.install_layout != "binaries":
        raise fatal(
            "unsupported install layout for {0}: {1}".format(
                tool.name, tool.install_layout
            )
        )
    prepared_extract_dir = prepare_extracted_tree(
        extract_dir, work_dir, tool.strip_components
    )
    for binary in tool.binaries:
        source = find_extracted_file(prepared_extract_dir, tool, binary, platform)
        target = install_dir / binary.output_name
        shutil.copy2(str(source), str(target))
        set_executable(target)


def release_download_url(tool: Tool, name: str) -> str:
    quoted_tag = urllib.parse.quote(tool.tag, safe="")
    quoted_name = urllib.parse.quote(name, safe="")
    return "https://github.com/{0}/releases/download/{1}/{2}".format(
        tool.repository, quoted_tag, quoted_name
    )


def download_release_asset(tool: Tool, name: str, destination: Path) -> None:
    info("downloading {0}".format(name))
    download_url(release_download_url(tool, name), destination)


def verify_checksum_signature(
    paths: InstallPaths,
    tool: Tool,
    checksum: ChecksumSpec,
    manifest: Path,
    work_dir: Path,
) -> None:
    if not checksum.verify_sigstore:
        return

    cosign = paths.vendor / "cosign" / "cosign"
    if not is_executable_file(cosign):
        raise fatal(
            "{0} requires vendored cosign for checksum verification".format(tool.name)
        )

    if checksum.sigstore_bundle_name:
        bundle_name = format_template(checksum.sigstore_bundle_name, tool)
        bundle = work_dir / bundle_name
        download_release_asset(tool, bundle_name, bundle)
        command = [str(cosign), "verify-blob", "--bundle", str(bundle)]
        if checksum.bundle_identity:
            command.extend(["--certificate-identity", checksum.bundle_identity])
        if checksum.bundle_identity_regexp:
            command.extend(
                ["--certificate-identity-regexp", checksum.bundle_identity_regexp]
            )
        if checksum.bundle_issuer:
            command.extend(["--certificate-oidc-issuer", checksum.bundle_issuer])
        command.append(str(manifest))
        run_command(command)
        return

    if checksum.certificate_name and checksum.signature_name:
        certificate_name = format_template(checksum.certificate_name, tool)
        signature_name = format_template(checksum.signature_name, tool)
        certificate = work_dir / certificate_name
        signature = work_dir / signature_name
        download_release_asset(tool, certificate_name, certificate)
        download_release_asset(tool, signature_name, signature)
        command = [
            str(cosign),
            "verify-blob",
            str(manifest),
            "--certificate",
            str(certificate),
            "--signature",
            str(signature),
        ]
        if checksum.certificate_identity_regexp:
            command.extend(
                ["--certificate-identity-regexp", checksum.certificate_identity_regexp]
            )
        if checksum.certificate_issuer:
            command.extend(["--certificate-oidc-issuer", checksum.certificate_issuer])
        run_command(command)
        return

    raise fatal("{0} has incomplete Sigstore verification metadata".format(tool.name))


def prepare_checksum(
    paths: InstallPaths,
    tool: Tool,
    selected_asset: str,
    work_dir: Path,
) -> Optional[str]:
    if tool.checksum is None:
        reason = tool.missing_checksum_exception
        if not reason:
            raise fatal("{0} has no checksum manifest configured".format(tool.name))
        warn("{0}: accepting missing checksum manifest: {1}".format(tool.name, reason))
        return None

    manifest_name = format_template(tool.checksum.asset_name, tool)
    manifest = work_dir / manifest_name
    download_release_asset(tool, manifest_name, manifest)
    verify_checksum_signature(paths, tool, tool.checksum, manifest, work_dir)
    return manifest_checksum(manifest, selected_asset)


def install_tool(
    paths: InstallPaths,
    platform: Platform,
    tool: Tool,
    offline: bool = False,
    disable_selinux: bool = False,
    selinux_policy_status: Optional[Dict[str, bool]] = None,
) -> None:
    policy_status = selinux_policy_status if selinux_policy_status is not None else {}
    if installed_state_ok(paths, tool, platform):
        info("{0} {1} already installed".format(tool.name, tool.version))
        apply_tool_selinux_policy(
            paths,
            platform,
            tool,
            policy_status,
            disable_selinux=disable_selinux,
        )
        return
    if offline:
        warn(
            "{0} {1} is not installed; skipping download".format(
                tool.name, tool.version
            )
        )
        return

    install_regular_tool(paths, platform, tool)
    apply_tool_selinux_policy(
        paths,
        platform,
        tool,
        policy_status,
        disable_selinux=disable_selinux,
    )


def install_regular_tool(paths: InstallPaths, platform: Platform, tool: Tool) -> None:
    selected_asset = asset_name(tool, platform)
    info("installing {0} {1}".format(tool.name, tool.version))
    verify_tag_and_commit(tool)

    with staging_directory(paths, tool) as stage:
        work = stage / "work"
        downloads = work / "downloads"
        install_dir = stage / "install"
        work.mkdir(parents=True)
        install_dir.mkdir(parents=True)
        checksum = prepare_checksum(paths, tool, selected_asset, work)
        if checksum is not None:
            verify_tag_and_commit(tool, check_signature=False)
        downloaded = downloads / selected_asset
        downloads.mkdir(parents=True, exist_ok=True)
        download_release_asset(tool, selected_asset, downloaded)
        verify_tag_and_commit(tool, check_signature=False)
        if checksum:
            verify_file_sha256(downloaded, checksum)
        install_downloaded_asset(tool, platform, downloaded, install_dir, work)
        write_version_file(install_dir / "version", version_data(tool, selected_asset))
        replace_tool_directory(paths, tool, install_dir)
    ensure_tool_links(paths, tool, platform)


def resolve_install_name(name: str, tools: Mapping[str, Tool]) -> Optional[str]:
    if name in tools:
        return name
    if name in ALIASES:
        return ALIASES[name]
    for tool in tools.values():
        if name in tool.aliases:
            return tool.name
    return None


def resolved_install_order(
    names: Sequence[str], tools: Mapping[str, Tool]
) -> List[str]:
    resolved = []
    temporary: Set[str] = set()
    permanent: Set[str] = set()

    def visit(name: str) -> None:
        if name not in tools:
            raise fatal("unknown dependency: {0}".format(name))
        if name in permanent:
            return
        if name in temporary:
            raise fatal("cyclic dependency involving {0}".format(name))
        temporary.add(name)
        for dependency in tools[name].dependencies:
            visit(dependency)
        temporary.remove(name)
        permanent.add(name)
        resolved.append(name)

    for name in names:
        visit(name)
    return resolved


def preflight_tools(
    paths: InstallPaths,
    names: Sequence[str],
    tools: Mapping[str, Tool],
    platform: Platform,
) -> None:
    required = []
    for name in resolved_install_order(names, tools):
        tool = tools[name]
        if not installed_payload_ok(paths, tool, platform):
            required.extend(tool.required_external_tools(platform))
    check_external_tools(required)


def valid_names_message(tools: Mapping[str, Tool]) -> str:
    names = ", ".join(sorted(tools))
    alias_pairs = [
        "{0}->{1}".format(alias, target) for alias, target in sorted(ALIASES.items())
    ]
    for tool in tools.values():
        for alias in tool.aliases:
            alias_pairs.append("{0}->{1}".format(alias, tool.name))
    aliases = ", ".join(sorted(set(alias_pairs)))
    return "valid install names: {0}\naliases: {1}".format(names, aliases or "none")


def install_tool_names(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    requested: Sequence[str],
    offline: bool = False,
    disable_selinux: bool = False,
    selinux_policy_status: Optional[Dict[str, bool]] = None,
) -> None:
    canonical = []
    for name in requested:
        resolved = resolve_install_name(name, tools)
        if resolved is None:
            raise fatal(
                "unknown install name: {0}\n{1}".format(
                    name, valid_names_message(tools)
                )
            )
        canonical.append(resolved)
    ordered = resolved_install_order(canonical, tools)
    cleanup_stale_staging(paths, (tools[name] for name in ordered))
    if not offline:
        preflight_tools(paths, canonical, tools, platform)
    policy_status = selinux_policy_status if selinux_policy_status is not None else {}
    for name in ordered:
        install_tool(
            paths,
            platform,
            tools[name],
            offline=offline,
            disable_selinux=disable_selinux,
            selinux_policy_status=policy_status,
        )


def runcom_files(source_dir: Path) -> List[Path]:
    files = []
    if not source_dir.is_dir():
        raise fatal("runcom source is not a directory: {0}".format(source_dir))
    for root, dirs, names in os.walk(str(source_dir), followlinks=False):
        dirs.sort()
        for name in list(dirs):
            path = Path(root) / name
            if path.is_symlink():
                files.append(path)
                dirs.remove(name)
        for name in sorted(names):
            path = Path(root) / name
            if path.is_file() or path.is_symlink():
                files.append(path)
    return files


def target_for_runcom(home: Path, source_dir: Path, source: Path) -> Path:
    relative = source.relative_to(source_dir)
    return home / relative


def backup_fish_if_needed(paths: InstallPaths) -> None:
    fish = paths.home / ".config" / "fish"
    if not fish.exists() or fish.is_symlink():
        return
    timestamp = time.strftime("%Y%m%d%H%M%S")
    backup = fish.with_name("fish.backup-{0}".format(timestamp))
    suffix = 1
    while backup.exists():
        backup = fish.with_name("fish.backup-{0}-{1}".format(timestamp, suffix))
        suffix += 1
    warn("moving {0} to {1}".format(fish, backup))
    fish.rename(backup)


def install_runcoms(paths: InstallPaths, source_dir: Path) -> None:
    for source in runcom_files(source_dir):
        target = target_for_runcom(paths.home, source_dir, source)
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.is_symlink():
            info("Removing {0}".format(target))
            target.unlink()
        if target.exists():
            warn("Omitting {0}".format(target))
            continue
        info("Linking {0}".format(target))
        os.symlink(str(source), str(target))


def clean_runcoms(paths: InstallPaths, source_dir: Path) -> None:
    for source in runcom_files(source_dir):
        target = target_for_runcom(paths.home, source_dir, source)
        if target.is_symlink():
            info("Removing {0}".format(target))
            target.unlink()


def git_command_output(
    paths: InstallPaths,
    args: Sequence[str],
    env: Optional[Mapping[str, str]] = None,
) -> str:
    return command_output(["git", *args], cwd=paths.repository, env=env)


def run_git_command(
    paths: InstallPaths,
    args: Sequence[str],
    env: Optional[Mapping[str, str]] = None,
    stdout: Optional[Any] = None,
) -> None:
    run_command(["git", *args], cwd=paths.repository, env=env, stdout=stdout)


def apply_whitelabel_patch(paths: InstallPaths) -> None:
    check_external_tools(["git"])
    trunk = git_command_output(
        paths, ["rev-parse", "--verify", "refs/heads/trunk^{commit}"]
    )
    with tempfile.TemporaryDirectory() as temp_dir:
        temp = Path(temp_dir)
        index = temp / "index"
        config = temp / "gitconfig"
        patch = temp / "whitelabel.patch"
        message = temp / "message"
        with config.open("wb") as output:
            run_git_command(
                paths, ["show", "{0}:git/gitconfig".format(trunk)], stdout=output
            )
        with patch.open("wb") as output:
            run_git_command(
                paths,
                ["show", "{0}:git/whitelabel.patch".format(trunk)],
                stdout=output,
            )
        message.write_text("fix: apply whitelabel git config\n", encoding="utf-8")
        env = sanitized_environment()
        env["GIT_INDEX_FILE"] = str(index)
        run_git_command(paths, ["read-tree", "{0}^{{tree}}".format(trunk)], env=env)
        run_git_command(
            paths,
            ["apply", "--cached", "--whitespace=nowarn", str(patch)],
            env=env,
        )
        tree = git_command_output(paths, ["write-tree"], env=env)
        commit_env = sanitized_environment()
        commit_env["GIT_CONFIG_GLOBAL"] = str(config)
        commit = git_command_output(
            paths,
            ["commit-tree", "-S", tree, "-p", trunk, "-F", str(message)],
            env=commit_env,
        )
    run_git_command(
        paths,
        [
            "update-ref",
            "-m",
            "apply whitelabel patch",
            "refs/heads/whitelabel",
            commit,
        ],
    )
    info("whitelabel now points to {0}".format(commit))


def install_context_engineering(paths: InstallPaths, explicit: bool) -> None:
    if not paths.is_canonical():
        raise fatal(
            "context-engineering install requires {0}".format(
                paths.canonical_repository
            )
        )
    destination = paths.vendor / "context-engineering"
    existed = destination.exists()
    if not existed:
        try:
            check_external_tools(["git"])
            run_command(
                ["git", "clone", CONTEXT_ENGINEERING_REPOSITORY, str(destination)]
            )
        except ManageError:
            if explicit:
                raise
            warn("unable to clone context-engineering; continuing")
            return
    try:
        install_runcoms(paths, destination / "lib")
    except ManageError:
        if explicit or existed:
            raise
        warn("unable to install context-engineering runcoms; continuing")


def install_default(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    offline: bool = False,
    disable_selinux: bool = False,
    selinux_policy_status: Optional[Dict[str, bool]] = None,
) -> None:
    install_tool_names(
        paths,
        platform,
        tools,
        list(DEFAULT_INSTALL),
        offline=offline,
        disable_selinux=disable_selinux,
        selinux_policy_status=selinux_policy_status,
    )
    if not paths.is_canonical():
        warn(
            "not running from {0}; skipping runcom, fish, and context-engineering home changes".format(
                paths.canonical_repository
            )
        )
        return
    backup_fish_if_needed(paths)
    install_runcoms(paths, paths.repository / "runcoms")
    if offline:
        warn("offline install; skipping context-engineering clone")
        return
    install_context_engineering(paths, explicit=False)


def clean(paths: InstallPaths) -> None:
    if not paths.is_canonical():
        raise fatal(
            "clean requires canonical repository path: {0}".format(
                paths.canonical_repository
            )
        )
    clean_runcoms(paths, paths.repository / "runcoms")


def required_env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise fatal("{0} environment variable not set".format(name))
    return value


def restic_repository_url(bucket: str) -> str:
    if not bucket:
        raise fatal("restic bucket must not be empty")
    return "b2:{0}:/".format(bucket)


def restic_connection_option(connections: int) -> str:
    if connections < 1:
        raise fatal("restic connections must be at least 1")
    return "b2.connections={0}".format(connections)


def ensure_restic_installed(
    paths: InstallPaths, platform: Platform, tools: Mapping[str, Tool]
) -> Path:
    install_tool_names(paths, platform, tools, ["restic"])
    binary = paths.bin / "restic"
    if not binary.exists():
        raise fatal("restic install did not create {0}".format(binary))
    return binary


def restic_environment() -> Dict[str, str]:
    env = sanitized_environment()
    for name in ("B2_ACCOUNT_ID", "B2_ACCOUNT_KEY", "B2_BUCKET_NAME"):
        env.pop(name, None)
    env["B2_ACCOUNT_ID"] = required_env("RESTIC_B2_ACCOUNT_ID")
    env["B2_ACCOUNT_KEY"] = required_env("RESTIC_B2_ACCOUNT_KEY")
    return env


def run_restic(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    restic_args: Sequence[str],
    cwd: Optional[Path] = None,
) -> None:
    binary = ensure_restic_installed(paths, platform, tools)
    run_command(
        [str(binary), *restic_args],
        cwd=cwd,
        env=restic_environment(),
        interactive=True,
    )


def restic_init(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    bucket: str,
    connections: int,
) -> None:
    run_restic(
        paths,
        platform,
        tools,
        [
            "init",
            "-o",
            restic_connection_option(connections),
            "-r",
            restic_repository_url(bucket),
        ],
    )


def restic_backup(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    source: Path,
    bucket: str,
    connections: int,
) -> None:
    if not source.is_dir():
        raise fatal("restic backup source is not a directory: {0}".format(source))
    exclude_file = paths.repository / RESTIC_EXCLUDE_FILE
    if not exclude_file.is_file():
        raise fatal("restic exclude file is missing: {0}".format(exclude_file))
    run_restic(
        paths,
        platform,
        tools,
        [
            "backup",
            "--exclude-file",
            str(exclude_file),
            "-o",
            restic_connection_option(connections),
            "-r",
            restic_repository_url(bucket),
            ".",
        ],
        cwd=source,
    )


def restic_restore(
    paths: InstallPaths,
    platform: Platform,
    tools: Mapping[str, Tool],
    target: Path,
    bucket: str,
    snapshot: str,
    connections: int,
) -> None:
    run_restic(
        paths,
        platform,
        tools,
        [
            "restore",
            "-r",
            restic_repository_url(bucket),
            snapshot,
            "-o",
            restic_connection_option(connections),
            "--target",
            str(target),
        ],
    )


def raise_keyboard_interrupt(signum: int, frame: Optional[Any]) -> None:
    raise KeyboardInterrupt("received signal {0}".format(signum))


def install_signal_handlers() -> None:
    for signal_name in ("SIGTERM", "SIGHUP"):
        signum = getattr(signal, signal_name, None)
        if signum is not None:
            signal.signal(signum, raise_keyboard_interrupt)


def add_restic_common_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--bucket",
        required=True,
        help="Backblaze B2 bucket name for the restic repository",
    )
    parser.add_argument(
        "--connections",
        type=int,
        default=RESTIC_DEFAULT_B2_CONNECTIONS,
        help="B2 connection count passed as -o b2.connections (default: %(default)s)",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="manage")
    subparsers = parser.add_subparsers(dest="command", title="commands")
    install_parser = subparsers.add_parser("install", help="install tools and runcoms")
    install_parser.add_argument(
        "--offline",
        action="store_true",
        help="skip tool downloads and only relink already installed tools",
    )
    install_parser.add_argument(
        "--disable-selinux",
        action="store_true",
        help="skip SELinux policy compilation, installation, and relabeling",
    )
    install_parser.add_argument("name", nargs="?", help="optional tool name to install")
    subparsers.add_parser("clean", help="clean runcom symlinks")
    subparsers.add_parser(
        "whitelabel", help="force whitelabel to trunk plus the saved patch"
    )

    restic_parser = subparsers.add_parser("restic", help="run restic operations")
    restic_subparsers = restic_parser.add_subparsers(
        dest="restic_command", title="restic commands"
    )
    restic_init_parser = restic_subparsers.add_parser(
        "init", help="initialize the configured restic repository"
    )
    add_restic_common_options(restic_init_parser)

    restic_backup_parser = restic_subparsers.add_parser(
        "backup", help="back up a source directory with restic"
    )
    restic_backup_parser.add_argument(
        "--path",
        required=True,
        type=Path,
        help="directory to back up",
    )
    add_restic_common_options(restic_backup_parser)

    restic_restore_parser = restic_subparsers.add_parser(
        "restore", help="restore a restic snapshot"
    )
    restic_restore_parser.add_argument(
        "--path",
        required=True,
        type=Path,
        help="directory where restic restores files",
    )
    restic_restore_parser.add_argument(
        "--snapshot",
        default="latest",
        help="snapshot ID or latest selector to restore (default: %(default)s)",
    )
    add_restic_common_options(restic_restore_parser)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    try:
        install_signal_handlers()
        paths = InstallPaths(repository=repository_dir(), home=home_dir())
        tools = TOOLS
        parser = build_parser()
        args = parser.parse_args(argv)
        if args.command == "install":
            platform = current_platform()
            selinux_policy_status: Dict[str, bool] = {}
            if args.name == "context-engineering":
                if args.offline:
                    warn("offline install; skipping context-engineering clone")
                else:
                    install_context_engineering(paths, explicit=True)
            elif args.name:
                install_tool_names(
                    paths,
                    platform,
                    tools,
                    [args.name],
                    offline=args.offline,
                    disable_selinux=args.disable_selinux,
                    selinux_policy_status=selinux_policy_status,
                )
            else:
                install_default(
                    paths,
                    platform,
                    tools,
                    offline=args.offline,
                    disable_selinux=args.disable_selinux,
                    selinux_policy_status=selinux_policy_status,
                )
            return 0
        if args.command == "clean":
            clean(paths)
            return 0
        if args.command == "whitelabel":
            apply_whitelabel_patch(paths)
            return 0
        if args.command == "restic":
            platform = current_platform()
            if args.restic_command == "init":
                restic_init(paths, platform, tools, args.bucket, args.connections)
                return 0
            if args.restic_command == "backup":
                restic_backup(
                    paths, platform, tools, args.path, args.bucket, args.connections
                )
                return 0
            if args.restic_command == "restore":
                restic_restore(
                    paths,
                    platform,
                    tools,
                    args.path,
                    args.bucket,
                    args.snapshot,
                    args.connections,
                )
                return 0
            parser.parse_args(["restic", "--help"])
            return 0
        parser.print_help()
        return 0
    except KeyboardInterrupt as exc:
        print("interrupted: {0}".format(exc), file=sys.stderr)
        return 130
    except ManageError as exc:
        print("error: {0}".format(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
