[alias]
  amend = commit --amend
  current = "!svu --tag-mode all-branches current"
  difft = difftool
  major = "!svu --tag-mode all-branches major"
  minor = "!svu --tag-mode all-branches minor"
  next = "!svu --tag-mode all-branches next"
  patch = "!svu --tag-mode all-branches patch"
  todo = grep -iEI "TODO|FIXME|FIX"
  who = "!sh -c 'git shortlog -s -n --all --no-merges -e'"

[branch]
  sort = -committerdate

[color]
  ui = never

[commit]
  gpgSign = true

[column]
  ui = never

[core]
  attributesFile = ~/.dotfiles/git/gitattributes
  excludesFile = ~/.dotfiles/git/gitignore
  ignoreCase = false
  pager = env HUNK_MCP_DISABLE=1 hunk pager
  whitespace = -trailing-space

[credential]
  helper = cache --timeout=36000

[diff]
  tool = difftastic
  algorithm = histogram
  colorMoved = default
  submodule = log
  mnemonicPrefix = true
  renames = true

[fetch]
  ; prune = true
  ; pruneTags = true
  ; all = true
  fsckObjects = true

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = ~/.dotfiles/git/difftool "$MERGED" "$LOCAL" "$REMOTE"

[filter "lfs"]
  clean = git-lfs clean -- %f
  process = git-lfs filter-process
  required = true
  smudge = git-lfs smudge -- %f

[gpg]
  format = ssh

[init]
  templateDir = ~/.dotfiles/git/template/

[log]
  date = iso-local

[pager]
  difftool = true

[merge]
  conflictStyle = zdiff3

[pull]
  rebase = true

[push]
  default = simple
  followTags = true
  autoSetupRemote = true

[rebase]
  autoStash = true
  updateRefs = true

[receive]
  fsckObjects = true

[status]
  relativePaths = true
  submoduleSummary = false

[tag]
  gpgSign = true
  sort = version:refname

[transfer]
  fsckObjects = true

[url "git@github.com:"]
  insteadOf = "gh:"
  insteadOf = "git://github.com"
  pushInsteadOf = "git://github.com/"
  pushInsteadOf = "github:"
  pushInsteadOf = "https://github.com/"

[url "git@gist.github.com:"]
  insteadOf = "gst:"
  pushInsteadOf = "gist:"
  pushInsteadOf = "git://gist.github.com/"
  pushInsteadOf = "https://gist.github.com/"

[user]
  email = 178086254+yyxi@users.noreply.github.com
  name = yyxi

[gpg "ssh"]
  defaultKeyCommand = ssh-add -L

[rerere]
  enabled = true
  autoupdate = true
