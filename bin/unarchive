#!/usr/bin/env fish
#
# Extracts the contents of archives.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

set remove_archive 1
set success 0
set file_name ""
set file_path ""
set extract_dir ""
set _gzip_bin ""
set _bzip2_bin ""
set _xz_bin ""
set _zstd_bin ""

if test (count $argv) -eq 0
    echo "usage: unarchive [-option] [file ...]

options:
    -r, --remove    remove archive
" >&2
    return 1
end

set remove_archive 1
if test "$argv[1]" = -r; or test "$argv[1]" = --remove
    set remove_archive 0
    set argv $argv[2..-1]
end

# Check for dropin/multi-threaded replacements
if command -v pigz >/dev/null
    set _gzip_bin pigz
else
    set _gzip_bin gzip
end

if command -v pixz >/dev/null
    set _xz_bin pixz
else
    set _xz_bin xz
end

if command -v lbzip2 >/dev/null
    set _bzip2_bin lbzip2
else if command -v pbzip2 >/dev/null
    set _bzip2_bin pbzip2
else
    set _bzip2_bin bzip2
end

set _zstd_bin zstd

for file in $argv
    if not test -s "$file"
        echo "unarchive: file not valid: $file" >&2
        continue
    end

    set success 0
    set file_name (basename "$file")
    set file_path (realpath "$file")
    set extract_dir (string replace -r '\.[^.]*$' '' "$file_name")

    switch (string lower "$file")
        case "*.tar.gz" "*.tgz"
            tar -xvf "$file" --use-compress-program="$_gzip_bin"
        case "*.tar.bz2" "*.tbz" "*.tbz2"
            tar -xvf "$file" --use-compress-program="$_bzip2_bin"
        case "*.tar.xz" "*.txz"
            tar -xvf "$file" --use-compress-program="$_xz_bin"
        case "*.tar.lzma" "*.tlz"
            if tar --lzma --help &>/dev/null
                tar --lzma -xvf "$file"
            else
                lzcat "$file" | tar -xvf -
            end
        case "*.tar.zst" "*.tzst"
            tar -xvf "$file" --use-compress-program="$_zstd_bin"
        case "*.tar"
            tar -xvf "$file"
        case "*.gz"
            gunzip "$file"
        case "*.bz2"
            bunzip2 "$file"
        case "*.xz"
            unxz "$file"
        case "*.lzma"
            unlzma "$file"
        case "*.Z"
            uncompress "$file"
        case "*.zip" "*.jar"
            unzip "$file" -d "$extract_dir"
        case "*.rar"
            if command -v unrar >/dev/null
                unrar x -ad "$file"
            else if command -v rar >/dev/null
                rar x -ad "$file"
            else
                unar -d "$file"
            end
        case "*.7z"
            7z x "$file" -o"$extract_dir"
        case "*.deb"
            mkdir -p "$extract_dir/control"
            mkdir -p "$extract_dir/data"
            cd "$extract_dir"
            ar vx "$file_path" >/dev/null
            cd control
            tar xvf ../control.tar.*
            cd ../data
            tar xvf ../data.tar.*
            cd ..
            rm control.tar.* data.tar.* debian-binary
            cd ..
        case "*"
            echo "unarchive: cannot extract: $file" >&2
            set success 1
    end

    set success (math "max($success, $status)")
    if test $success -eq 0; and test $remove_archive -eq 0
        rm "$file"
    end
end
